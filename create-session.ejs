<%- include('partials/header') %><div class="form-card wide"><p class="eyebrow">NEW MATCH</p><h1>Create Sport Session</h1><p>Set up the match and tell players where and when to meet.</p><form action="/sessions" method="POST"><div class="two"><label>Sport<select name="sport" required><option value="">Select a sport</option><% sports.forEach(s=>{ %><option value="<%= s._id %>"><%= s.name %></option><% }) %></select></label><label>Venue<input type="text" name="venue" placeholder="VIT Sports Ground" required></label></div><div class="two"><label>Team 1 players<input type="text" name="team1" placeholder="Ravi, Anu, Priya"></label><label>Team 2 players<input type="text" name="team2" placeholder="Rahul, Kiran, Divya"></label></div><div class="two"><label>Additional players needed<input type="number" name="additionalPlayersNeeded" min="0" value="2" required></label><label>Date<input type="date" name="date" min="<%= new Date().toISOString().slice(0,10) %>" required></label></div><label>Time<input type="time" name="time" required></label><div class="tip">Tip: Enter existing player names in the team fields. The additional-player count represents open slots that other signed-in users can join.</div><button class="btn">Create Session</button><a class="btn outline" href="/dashboard">Cancel</a></form></div><%- include('partials/footer') %>
