<%- include('partials/header') %><div class="page-head"><div><p class="eyebrow">ADMIN ANALYTICS</p><h1>Session Reports</h1><p>See completed sessions and the relative popularity of sports.</p></div></div><div class="form-card"><form method="GET" action="/reports" class="filter"><label>From<input type="date" name="from" value="<%= from %>" required></label><label>To<input type="date" name="to" value="<%= to %>" required></label><button class="btn">Apply Filter</button></form></div><div class="stats"><div><span><%= played.length %></span><small>Sessions Played</small></div><div><span><%= sportCounts.length %></span><small>Sports Played</small></div></div><div class="card"><h2>Sport Popularity</h2><% if(!sportCounts.length){ %><p>No completed sessions in this period.</p><% } else { %><div class="report-list"><% sportCounts.forEach((item,i)=>{ %><div class="report-row"><span><b><%= i+1 %>.</b> <%= item[0] %></span><strong><%= item[1] %> session<%= item[1]===1?'':'s' %></strong></div><% }) %></div><% } %></div><div class="card"><h2>Played Sessions</h2><div class="table-wrap"><table><thead><tr><th>Sport</th><th>Date</th><th>Time</th><th>Venue</th><th>Status</th></tr></thead><tbody><% played.forEach(s=>{ %><tr><td><%= s.sport?.name||'Unknown' %></td><td><%= s.date %></td><td><%= s.time %></td><td><%= s.venue %></td><td><span class="status open">Played</span></td></tr><% }) %></tbody></table></div></div><%- include('partials/footer') %>
