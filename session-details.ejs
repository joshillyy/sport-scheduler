<%- include('partials/header') %><div class="page-head"><div><span class="badge"><%= session.sport.name %></span><h1><%= session.date %> • <%= session.time %></h1><p>📍 <%= session.venue %> • Created by <%= session.creator.name %></p></div><span class="status <%= session.status %>"><%= session.status %></span></div><div class="details-grid"><div class="card"><h2>Teams</h2><h3>Team 1</h3><p><%= session.team1.join(', ') || 'No names added' %></p><h3>Team 2</h3><p><%= session.team2.join(', ') || 'No names added' %></p></div><div class="card"><h2>Joined Players</h2><% if(session.joinedPlayers.length){ %><ul class="players"><% session.joinedPlayers.forEach(p=>{ %><li><span><%= p.name %></span><span>Joined</span></li><% }) %></ul><% } else { %><p>No players have joined yet.</p><% } %><p class="slot-count"><%= session.joinedPlayers.length %> / <%= session.additionalPlayersNeeded %> open-player slots filled</p><% if(session.status==='cancelled'){ %><div class="alert error">Cancelled: <%= session.cancellationReason %></div><% } %></div></div><a class="btn outline" href="/dashboard">← Back to Dashboard</a><%- include('partials/footer') %>
