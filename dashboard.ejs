<%- include('partials/header') %><div class="page-head"><div><p class="eyebrow">YOUR SPORTS HUB</p><h1>Dashboard</h1><p>Manage your created sessions and discover matches to join.</p></div><a class="btn" href="/sessions/new">+ Create Session</a></div>
<section><h2>My Created Sessions</h2><% if(!mine.length){ %><div class="empty">You haven't created any sessions yet.</div><% } %><div class="grid"><% mine.forEach(s=>{ %><article class="card <%= s.status==='cancelled'?'cancelled':'' %>"><div class="card-top"><span class="badge"><%= s.sport.name %></span><span class="status <%= s.status %>"><%= s.status %></span></div><h3><%= s.date %> • <%= s.time %></h3><p>📍 <%= s.venue %></p><p>👥 Team 1: <%= s.team1.join(', ') || 'Not specified' %></p><p>👥 Team 2: <%= s.team2.join(', ') || 'Not specified' %></p><p>➕ Additional slots: <%= s.additionalPlayersNeeded %> • Joined: <%= s.joinedPlayers.length %></p><a class="text-link" href="/sessions/<%= s._id %>">View details →</a><% if(s.status==='open'){ %><details><summary>Cancel session</summary><form action="/sessions/<%= s._id %>/cancel" method="POST" class="cancel-form"><textarea name="reason" required placeholder="Reason for cancellation"></textarea><button class="btn danger">Confirm Cancellation</button></form></details><% } else { %><p class="cancel-reason">Cancellation reason: <%= s.cancellationReason %></p><% } %></article><% }) %></div></section>
<section><h2>Sessions I Joined</h2><% if(!joined.length){ %><div class="empty">You haven't joined any sessions yet.</div><% } %><div class="grid"><% joined.forEach(s=>{ %><article class="card"><div class="card-top"><span class="badge"><%= s.sport.name %></span><span class="status <%= s.status %>"><%= s.status %></span></div><h3><%= s.date %> • <%= s.time %></h3><p>📍 <%= s.venue %></p><p>Created by <strong><%= s.creator.name %></strong></p><a class="btn small" href="/sessions/<%= s._id %>">View Session</a><% if(s.status==='cancelled'){ %><p class="cancel-reason">Reason: <%= s.cancellationReason %></p><% } %></article><% }) %></div></section>
<section><h2>Available Sessions</h2><% if(!available.length){ %><div class="empty">No available sessions right now.</div><% } %><div class="grid"><% available.forEach(s=>{ const full=s.joinedPlayers.length>=s.additionalPlayersNeeded; %><article class="card"><div class="card-top"><span class="badge"><%= s.sport.name %></span><span class="status open">open</span></div><h3><%= s.date %> • <%= s.time %></h3><p>📍 <%= s.venue %></p><p>Created by <strong><%= s.creator.name %></strong></p><p>Players joined: <%= s.joinedPlayers.length %> / <%= s.additionalPlayersNeeded %></p><a class="text-link" href="/sessions/<%= s._id %>">View details →</a><% if(!full){ %><form action="/sessions/<%= s._id %>/join" method="POST"><button class="btn full">Join Session</button></form><% } else { %><button class="btn full disabled" disabled>Session Full</button><% } %></article><% }) %></div></section><%- include('partials/footer') %>
